{
  "name": "@tonic-ui/eslint-plugin",
  "description": "ESLint plugin for Tonic UI component styling rules.",
  "private": true,
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node scripts/generate-rule-data.mjs",
    "check:data": "node scripts/generate-rule-data.mjs --check",
    "clean": "del coverage",
    "lint": "eslint --ext .js,.jsx,.mjs .",
    "test": "node --test test/*.test.mjs",
    "pre-push": "bash -c 'echo -e \"=> \\e[1;33m$npm_package_name\\e[0m\"' && yarn run build && yarn run check:data && yarn run lint && yarn run test"
  },
  "peerDependencies": {
    "eslint": "^9.26.0"
  },
  "devDependencies": {
    "@tonic-ui/styled-system": "workspace:*",
    "del-cli": "^5.0.0",
    "eslint": "^9.26.0",
    "eslint-config-trendmicro": "^4.4.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^15.0.0"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "tonic-ui"
  ],
  "homepage": "https://github.com/trendmicro-frontend/tonic-ui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trendmicro-frontend/tonic-ui.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/trendmicro-frontend/tonic-ui/issues"
  }
}
