{
  "name": "esm-cdn-with-fallback",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:inspector": "node scripts/build.mjs --inspector",
    "dev": "node scripts/build.mjs && vite",
    "dev:inspector": "node scripts/build.mjs --inspector && vite --mode inspector",
    "preview": "vite preview --mode app --outDir dist",
    "preview:inspector": "vite preview --mode shell --outDir dist"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/is-prop-valid": "1.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@tonic-ui/react": "3.0.0-alpha.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.3"
  }
}
